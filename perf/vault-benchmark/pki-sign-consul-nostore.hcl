# Vault PKI baseline shaped like Consul's Connect CA:
#   * EC P-256 root + intermediate (Consul default private_key_type/bits)
#   * role mirrors Consul's "leaf-cert" role: allow_any_name, spiffe:// URI SANs,
#     require_cn=false, no_store=true
#   * CSR = EC P-256 with a SPIFFE URI SAN (generated by run-vault-benchmark.sh)
#
# Global settings (address, token, duration, workers, rps) are prepended by
# run-vault-benchmark.sh. __CSR_FILE__ is replaced at runtime.

test "pki_sign" "consul_leaf_nostore" {
  weight = 100

  config {
    setup_delay = "2s"

    root_ca {
      common_name = "perf root"
      key_type    = "ec"
      key_bits    = 256
    }

    intermediate_csr {
      common_name = "perf intermediate"
      key_type    = "ec"
      key_bits    = 256
    }

    role {
      allow_any_name    = true
      enforce_hostnames = false
      allowed_uri_sans  = "spiffe://*"
      require_cn        = false
      key_type          = "any"
      ttl               = "168h"
      max_ttl           = "168h"
      no_store          = true
    }

    sign {
      common_name = "perf-vb"
      csr         = "__CSR_FILE__"
      ttl         = "168h"
    }
  }
}
